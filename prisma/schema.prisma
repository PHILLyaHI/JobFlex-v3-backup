model ReferralConversion {
  id          String    @id @default(cuid())
  codeId      String
  signupEmail String
  signupOrgId String?
  status      String    @default("PENDING") // PENDING | CONVERTED | PAID
  note        String?
  createdAt   DateTime  @default(now())
  convertedAt DateTime?
  // Reward credit tracking — PAID means a 50%-of-one-month Stripe customer-balance
  // credit landed on the referrer org (rewardStripeTxnId). CONVERTED with no
  // rewardAppliedAt = credit pending (referrer has no Stripe customer yet).
  rewardCents       Int?
  rewardAppliedAt   DateTime?
