// ─────────────────────────────────────────────
// Calendar — Appointments + Blocked Time
// ─────────────────────────────────────────────

model Appointment {
  id             String    @id @default(cuid())
  organizationId String
  // Linked entity — at most one of lead/client/proposal (enforced in the action).
  leadId         String?
  clientId       String?
  proposalId     String?
  // Who created it — drives the sales-rep calendar scope ("mine or staffed-on-me").
  // Nullable: appointments predating this column have no known creator.
  createdById    String?
  title          String
  status         String    @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELED | NO_SHOW
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])
  proposal     Proposal?    @relation(fields: [proposalId], references: [id])
  createdBy    User?        @relation("AppointmentCreator", fields: [createdById], references: [id])
  assignments  AppointmentAssignment[]

  @@index([organizationId, startsAt])
}

// Staff (sales / installers — any WorkerProfile) attached to an appointment.
// Mirrors JobAssignment but without the accept/decline lifecycle: appointment
// staffing is informational, so there is no status column.
model AppointmentAssignment {
  id            String   @id @default(cuid())
  appointmentId String
  workerId      String
  createdAt     DateTime @default(now())

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  worker      WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, workerId])
}

model BlockedTime {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String?  // user it belongs to (vacation, etc); null = whole-org block
  reason         String   @default("Blocked")
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?        @relation(fields: [ownerId], references: [id])

  @@index([organizationId, startsAt])
}

// Recurring weekly unavailability ("every Saturday morning"). One row per
// weekly pattern; minutes-from-midnight bounds keep it timezone-simple and
// SQLite-friendly. Owned by a User (same domain as BlockedTime.ownerId) so it
// covers owners/managers as well as invited workers.
model UnavailabilityRule {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  dayOfWeek      Int      // 0 = Sunday … 6 = Saturday
  startMinute    Int      // minutes from local midnight, 0–1440
  endMinute      Int
  reason         String   @default("Unavailable")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  exceptions   UnavailabilityException[]

  @@index([organizationId, ownerId])
}

// Per-instance override of a recurring rule. `freed = true` means "this
// specific date is open even though the rule blocks it" — the rest of the
// series stays blocked.
model UnavailabilityException {
  id     String   @id @default(cuid())
  ruleId String
  date   DateTime // local midnight of the overridden occurrence
  freed  Boolean  @default(true)

  rule UnavailabilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
}

// ─────────────────────────────────────────────
// Projects (multi-job grouping)
// ─────────────────────────────────────────────

model Project {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  status         String    @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | ARCHIVED
  startsAt       DateTime?
  endsAt         DateTime?
  budget         Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs         Job[]

  @@index([organizationId])
}

// ─────────────────────────────────────────────
// Applicants (hiring)
// ─────────────────────────────────────────────

model Applicant {
  id             String   @id @default(cuid())
  organizationId String
  fullName       String
  email          String
  phone          String?
  role           String
  status         String   @default("APPLIED") // APPLIED | INTERVIEWING | HIRED | REJECTED
  source         String?
  notes          String?
  resumeUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

// ─────────────────────────────────────────────
// Influencer / affiliate
// ─────────────────────────────────────────────

model InfluencerPayout {
  id             String    @id @default(cuid())
  organizationId String
  influencerName String
  amount         Float
  status         String    @default("PENDING") // PENDING | PAID | FAILED
  period         String
  paidAt         DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// DEPRECATED (kept read-only for the legacy /dashboard/trade view): these are
// org-scoped, name-keyed and carry no Stripe attribution. The platform-scoped
// Influencer/PromoCode/Attribution/CommissionLedger models below supersede them.
model InfluencerStatement {
  id             String   @id @default(cuid())
  organizationId String
  influencerName String
  clicks         Int      @default(0)
  conversions    Int      @default(0)
  earnings       Float    @default(0)
  period         String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, period])
}

// ─────────────────────────────────────────────
// Admin console — Stripe-truth influencer / promo / commission / payouts.
// Money is integer cents. Stripe is the source of truth; these tables cache it
// and are fully rebuildable from Stripe via webhooks + reconciliation.
// ─────────────────────────────────────────────

// A platform influencer/affiliate. Optionally linked to a User login; otherwise
// authenticates via its own credentials (separate influencer login surface).
model Influencer {
  id               String   @id @default(cuid())
  userId           String?  @unique
  email            String   @unique
  displayName      String
  hashedPassword   String?  // set when the influencer logs in via the separate surface
  status           String   @default("PENDING") // InfluencerStatus
  connectAccountId String?  @unique              // Stripe Connect acct_...
  connectStatus    String   @default("NONE")     // ConnectStatus (mirror of account state)
  payoutsEnabled   Boolean  @default(false)      // mirror of account.payouts_enabled
  defaultCurrency  String   @default("usd")
  minPayoutCents   Int      @default(2500)        // payout request threshold
  holdDays         Int      @default(30)          // escrow window before commission clears
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  promoCodes     PromoCode[]
  attributions   Attribution[]
  ledgerEntries  CommissionLedger[]
  payoutRequests PayoutRequest[]
  transfers      PayoutTransfer[]

  @@index([status])
  @@index([connectAccountId])
}

// A Stripe coupon/promotion code owned by an influencer, plus OUR per-code
// commission rule (Stripe knows the customer discount; the payout rate is ours).
model PromoCode {
  id                    String   @id @default(cuid())
  influencerId          String
  stripeCouponId        String                          // coupon_...
  stripePromotionCodeId String   @unique                 // promo_...
  code                  String   @unique                 // redeemable string, e.g. JAMIE20
  active                Boolean  @default(true)
  commissionType        String                           // CommissionType: PERCENT | FLAT
  commissionRateBps     Int?                             // basis points when PERCENT (2000 = 20%)
  commissionFlatCents   Int?                             // flat cents when FLAT
  commissionBasis       String   @default("NET")         // CommissionBasis
  durationType          String   @default("REPEATING")   // PromoDurationType
  durationMonths        Int?                             // required when REPEATING
  customerPercentOff    Int?                             // display mirror of the Stripe coupon percent_off
  clicks                Int      @default(0)             // promo-link landing visits (lightweight, no PII)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  influencer   Influencer    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  attributions Attribution[]
  signupOrganizations Organization[] @relation("OrgSignupPromo")

  @@index([influencerId])
  @@index([stripeCouponId])
}

// One row per Stripe subscription that ever carried a qualifying discount.
// Created ONLY from a Stripe-issued object (subscription/invoice), never from
// pre-checkout frontend intent — abandoned checkouts produce no attribution.
model Attribution {
  id                   String    @id @default(cuid())
  influencerId         String
  promoCodeId          String
  organizationId       String?                          // resolved via the Subscription mirror
  stripeCustomerId     String                            // cus_...
  stripeSubscriptionId String    @unique                 // sub_... — one attribution per subscription
  status               String    @default("ACTIVE")      // AttributionStatus
  firstPaidInvoiceAt   DateTime?
  qualifyingMonths     Int       @default(0)             // accrual counter for ONCE/REPEATING caps
  endedAt              DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  promoCode     PromoCode          @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  ledgerEntries CommissionLedger[]

  @@index([influencerId, status])
  @@index([stripeCustomerId])
}

// Append-only financial truth. Signed integer cents; balance = SUM(amountCents).
// idempotencyKey @unique is the linchpin against double-accrual across webhook
// retries and reconciliation re-runs.
model CommissionLedger {
  id               String    @id @default(cuid())
  influencerId     String
  attributionId    String?                              // null for PAID / ADJUSTMENT (span many attributions)
  entryType        String                               // LedgerEntryType
  amountCents      Int                                   // signed: ACCRUED +, REVERSED/PAID -
  currency         String    @default("usd")
  stripeInvoiceId  String?                               // in_...
  stripeChargeId   String?                               // ch_... (refund clawback source)
  stripeEventId    String?                               // evt_...
  clearsAt         DateTime?                             // ACCRUED clears after holdDays
  state            String    @default("PENDING")         // LedgerEntryState
  payoutTransferId String?
  idempotencyKey   String    @unique                     // accrue:<invoiceId> / reverse:<chargeId>:<refundId> / pay:<transferId>:<entryId>
  memo             String?
  createdAt        DateTime  @default(now())

  influencer  Influencer      @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  attribution Attribution?    @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  transfer    PayoutTransfer? @relation(fields: [payoutTransferId], references: [id], onDelete: SetNull)

  @@index([influencerId, state])
  @@index([stripeInvoiceId])
  @@index([attributionId])
}

// Influencer-initiated payout request; snapshots the cleared balance at request
// time. Admin approves, then a cron processes it into a PayoutTransfer.
model PayoutRequest {
  id             String    @id @default(cuid())
  influencerId   String
  amountCents    Int
  currency       String    @default("usd")
  status         String    @default("PENDING")          // PayoutRequestStatus
  requestedBy    String?                                 // admin userId or null (auto)
  approvedBy     String?
  approvedAt     DateTime?
  rejectedReason String?
  periodLabel    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  influencer Influencer       @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  transfers  PayoutTransfer[]

  @@index([influencerId, status])
}

// A Stripe Connect transfer of cleared commission to an influencer's account.
model PayoutTransfer {
  id                     String    @id @default(cuid())
  influencerId           String
  payoutRequestId        String?
  amountCents            Int
  currency               String    @default("usd")
  status                 String    @default("PENDING")   // PayoutTransferStatus
  stripeTransferId       String?   @unique                // tr_...
  stripeConnectAccountId String                           // acct_... destination
  failureReason          String?
  idempotencyKey         String    @unique                // passed to stripe.transfers.create
  createdAt              DateTime  @default(now())
  paidAt                 DateTime?

  influencer    Influencer         @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  payoutRequest PayoutRequest?     @relation(fields: [payoutRequestId], references: [id], onDelete: SetNull)
  ledgerEntries CommissionLedger[]

  @@index([influencerId, status])
}

// Idempotency log for inbound Stripe webhooks — eventId @unique drops replays.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("STRIPE")
  eventId     String    @unique                          // evt_...
  type        String
  status      String    @default("RECEIVED")             // WebhookEventStatus
  payloadHash String?
  error       String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([type, receivedAt])
}

// Stripe Price mirror. At most one active price per (plan, interval). Stripe
// Prices are immutable, so editing a price archives the old and points here.
// entitlements.ts remains the feature-gate source of truth.
model PlanPrice {
  id              String   @id @default(cuid())
  planSlug        String                                  // matches PLAN_TIERS (lowercased)
  interval        String                                  // BillingInterval: MONTH | YEAR
  stripeProductId String                                  // prod_...
  stripePriceId   String   @unique                         // price_... (active price)
  unitAmountCents Int
  currency        String   @default("usd")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  // "At most one active price per (plan, interval)" is enforced in the
  // repoint transaction (archive old → insert new), not by a DB constraint:
  // SQLite has no partial unique index, and many archived rows must coexist.
  @@index([planSlug, interval, active])
}

// Watermarks for the Stripe reconciliation backstop (list cursors per resource).
model SyncState {
  key       String   @id
  cursor    String
  updatedAt DateTime @updatedAt
}

// Persistent price-lookup cache for the estimator. Keyed on a normalized query
// (see normalizeSearchQuery) + location so a repeated lookup reuses a prior
// fetch when the price source (SerpAPI) is down. productsJson is a JSON-encoded
// product[] string (SQLite-safe / Postgres-portable, matching the schema-wide
// "JSON stored as String" convention). A daily cron prunes stale rows.
model ProductPriceCache {
  id              String   @id @default(cuid())
  normalizedQuery String
  location        String?
  productsJson    String
  source          String?
  currency        String   @default("usd")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([normalizedQuery, location])
  @@index([updatedAt])
}
