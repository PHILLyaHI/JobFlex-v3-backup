  tradeJob  TradeJob          @relation(fields: [tradeJobId], references: [id], onDelete: Cascade)
  author    User              @relation("TradeJobConvAuthor", fields: [authorId], references: [id])
  recipient User              @relation("TradeJobConvRecipient", fields: [recipientId], references: [id])
