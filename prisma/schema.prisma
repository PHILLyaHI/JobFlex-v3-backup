  @@unique([tradeJobId, recipientId])
  @@index([authorId])
  @@index([recipientId])
}

model TradeJobMessage {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String
  body           String
  createdAt      DateTime @default(now())

  conversation TradeJobConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User                 @relation("TradeJobMessageAuthor", fields: [authorId], references: [id])

  @@index([conversationId, createdAt])
}

