model PricingPlan {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String?
  priceCents      Int           // monthly price
  yearlyPriceCents Int?         // optional annual price (enables yearly checkout + savings display)
  interval        String  @default("month")
  trialDays       Int     @default(0)
  order           Int     @default(0)
  features        String
  limitsJson      String?  // numeric per-plan limits (see src/lib/planLimits.ts); null/absent key = unlimited
  active          Boolean @default(true)  // hidden from user surfaces + rejected at checkout when false
  highlight       Boolean @default(false) // "Most popular" badge on plan surfaces
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model SupportTicket {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  // submitter, when raised from the in-app support form
  subject        String
  body           String
  category       String   @default("general") // billing | technical | account | feature | general — for admin triage
  priority       String   @default("normal")  // low | normal | high — submitter-declared urgency
  status         String   @default("OPEN")
  adminReadAt    DateTime? // platform-admin "seen" marker; null = new/unread in the admin notification feed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model Specialty {
  id             String @id @default(cuid())
  organizationId String
  name           String
  promptPreamble String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

