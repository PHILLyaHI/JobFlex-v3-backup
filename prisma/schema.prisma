model Subscription {
  id                  String    @id @default(cuid())
  organizationId      String    @unique
  plan                String    @default("FREE")
  status              String    @default("FREE")
  provider            String    @default("STRIPE")
  externalCustomerId  String?
  externalSubId       String?
  currentPeriodEnd    DateTime?
  trialEndsAt         DateTime?
  // Stripe-truth mirror fields, synced from subscription/invoice webhooks.
  stripePriceId          String?
  appliedPromotionCodeId String?   // promo_... read off the subscription discount
  appliedCouponId        String?   // coupon_... fallback
  attributionId          String?   // → Attribution (influencer promo link)
  canceledAt             DateTime?
  createdAt           DateTime  @default(now())
