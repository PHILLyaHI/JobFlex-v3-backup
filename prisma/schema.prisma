model ChangeOrder {
  id             String    @id @default(cuid())
  organizationId String
  // A change order amends a contract. It attaches to either a Job (legacy) or a
  // Proposal (the contract itself) — exactly one is set, enforced in the action.
  jobId          String?
  proposalId     String?
  title          String
  description    String?
  amount         Float     // signed: positive adds, negative reduces
  status         String    @default("DRAFT") // DRAFT | SENT | APPROVED | DECLINED
  publicToken    String    @unique @default(cuid())
  sentAt         DateTime?
  approvedAt     DateTime?
  declinedAt     DateTime?
  approvedIp     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([jobId, status])
  @@index([proposalId, status])
  @@index([organizationId, status])
}

model ReviewRequest {
