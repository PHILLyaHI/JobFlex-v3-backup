// JobFlex Prisma schema — SQLite for local dev (easy swap to Postgres later).
// Enums moved to src/lib/prismaEnums.ts; string[] stored as JSON-encoded strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// Tenancy + Auth
// ─────────────────────────────────────────────

model Organization {
  id              String   @id @default(cuid())
  name            String
  slug            String   @unique
  logoUrl         String?
  primaryColor    String?
  billingEmail    String?
  phone           String?
  address         String?
  website         String?
  timezone        String   @default("America/New_York")
  defaultTaxRate  Float    @default(0)
  aiPromptCustom  String?
  publicProfileEnabled Boolean @default(false)
  landingHeroTitle    String?
  landingHeroSubtitle String?
  heroImageUrl        String?
  servicesJson        String?
  // Settings persistence — one JSON-as-String blob per settings page (hydrated whole on load).
  paymentSettingsJson  String? // settings/payment  {stripe,square,paypal,ach,currency,depositPct,netTerms,lateFeePct,autoRemind,lateFees}
  leadsSettingsJson    String? // settings/leads     {strategy,zips[],travelRadius,maxPerDay,maxPerRep,aiCategorize,instantSms,businessHours}
  gmailSettingsJson    String? // settings/gmail     {sendFromUser,trackOpens,autoSync,displayName,replyTo,signature}
  gmailTokensJson      String? // OAuth secrets      {accessToken,refreshToken,expiryDate,email} — set by the Gmail connect callback
  metaSettingsJson     String? // settings/meta      {connected,autoCreate,autoText,defaultPage,formCategory}
  proposalSettingsJson String? // settings/proposals {validityDays,markups{...},schedule[],terms,requireSig,autoFollowUp}
  // Lead Center matching profile — canonical TRADE_TYPES multi-select (JSON string[],
  // closed vocabulary from src/lib/tradeTypes.ts; distinct from the free-text Specialty
  // model which steers AI estimator prompts). lat/lng geocoded from `address` at
  // register/profile-save; orgs without coords are ineligible for platform lead offers.
  tradeTypesJson    String?  @default("[]")
  lat               Float?
  lng               Float?
  geocodedAt        DateTime?
  leadOffersEnabled Boolean  @default(true)
  // Pre-signup attribution stamp (first-write-wins: set once at account creation,
  // never overwritten). The money record stays Stripe-truth (Attribution model);
  // this is captured intent used for the signup pill + checkout auto-apply.
  signupPromoCode       String?
  signupPromoCodeId     String?
  attributionCapturedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  invites         Invite[]
  clients         Client[]
  leads           Lead[]
  proposals       Proposal[]
  templates       ProposalTemplate[]
  jobs            Job[]
  jobEvents       JobEvent[]
  workerProfiles  WorkerProfile[]
  payments        Payment[]
  invoices        Invoice[]
  activities      ActivityEvent[]
  conversations   Conversation[]
  announcements   Announcement[]
  emailTemplates  EmailTemplate[]
  followUpRules   FollowUpRule[]
  followUps       FollowUp[]
  aiDrafts        AiDraft[]
  aiPromptPacks   AiPromptPack[]
  aiEstimates     AiEstimate[]
  tags            Tag[]
  subscription    Subscription?
  supportTickets  SupportTicket[]
  specialties     Specialty[]
  homeownerReqs   HomeownerRequest[]
  leadOffers      LeadOffer[]
  changeOrders    ChangeOrder[]
  reviewRequests  ReviewRequest[]
  referralCodes   ReferralCode[]
  tradePosts      TradePost[]
  phoneCalls      AiPhoneCall[]
  appointments    Appointment[]
  blockedTimes    BlockedTime[]
  unavailabilityRules UnavailabilityRule[]
  projects        Project[]
  applicants      Applicant[]
  influencerPayouts    InfluencerPayout[]
  influencerStatements InfluencerStatement[]
  eagleViewReports     EagleViewReport[]
  signupPromo          PromoCode? @relation("OrgSignupPromo", fields: [signupPromoCodeId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([signupPromoCodeId])
}

// Cached EagleView roof-measurement reports. A report is a billable order, so we
// fetch + parse it once and reuse the result. modelJson holds the parsed
// RoofModel geometry (points/lines/faces); summaryJson the raw GetReport header.
model EagleViewReport {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reportId         Int
  status           String       @default("In Process")
  statusId         Int?
  address          String?
  city             String?
  state            String?
  zip              String?
  lat              Float?
  lng              Float?
  productId        Int?
  totalCost        Float?
  // Headline measurements (parsed from geometry; mirror EagleView's summary).
  areaSqft         Float?
  squares          Float?
  predominantPitch String?
  facetCount       Int?
  // JSON-as-String (SQLite): parsed RoofModel geometry + raw GetReport summary.
  modelJson        String?
  summaryJson      String?
  orderedById      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([organizationId, reportId])
  @@index([organizationId])
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  image           String?
  hashedPassword  String?
  emailVerified   DateTime?
  locale          String?
  // Platform-admin authority for the (admin) console. Distinct from the
  // org-level Membership.role — only flagged users may reach platform-wide
  // money/influencer pages. Tightens the old "any OWNER/ADMIN of any org" gate.
  isPlatformAdmin Boolean       @default(false)
  // Credential epoch for stateless-JWT session revocation. Stamped into the JWT
  // at sign-in and re-checked on every guarded request (requireUser); bumped on
  // password reset so all previously-issued tokens are invalidated at once —
  // the "log out everywhere" that a bare JWT strategy otherwise can't do.
  credentialVersion Int         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  activeOrgId     String?

  accounts        Account[]
  influencer      Influencer?
  supportTickets  SupportTicket[]
  sessions        Session[]
  memberships     Membership[]
  workerProfile   WorkerProfile?
  assignedLeads   Lead[]            @relation("LeadAssignee")
  claimedLeads    Lead[]            @relation("LeadClaimer")
  proposals       Proposal[]        @relation("ProposalOwner")
  activities      ActivityEvent[]
  messages        Message[]
  conversationParticipants ConversationParticipant[]
  sentInvites     Invite[]          @relation("InviteSender")
  referralCodes   ReferralCode[]
  tradePosts      TradePost[]
  tradeReplies    TradeReply[]
  blockedTimes    BlockedTime[]
  unavailabilityRules UnavailabilityRule[]
  appointmentsCreated Appointment[]     @relation("AppointmentCreator")
  jobEventsCreated    JobEvent[]        @relation("JobEventCreator")

  // Trade & Services (contractor-to-contractor job network)
  tradeNetworkProfile  TradeNetworkProfile?
  tradeJobsAuthored    TradeJob[]             @relation("TradeJobAuthor")
  tradeJobRecipients   TradeJobRecipient[]    @relation("TradeJobRecipientUser")
  tradeJobConvAuthored TradeJobConversation[] @relation("TradeJobConvAuthor")
  tradeJobConvReceived TradeJobConversation[] @relation("TradeJobConvRecipient")
  tradeJobMessages     TradeJobMessage[]      @relation("TradeJobMessageAuthor")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  type              String
  access_token      String?
  refresh_token     String?
  expires_at        Int?
  scope             String?
  token_type        String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String       @default("USER")
  createdAt      DateTime     @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("USER")
  token          String       @unique
  invitedById    String?
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("InviteSender", fields: [invitedById], references: [id])

  @@index([organizationId, email])
}

// ─────────────────────────────────────────────
// CRM
// ─────────────────────────────────────────────

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  address        String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  customFields   String?
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposals    Proposal[]
  jobs         Job[]
  activities   ActivityEvent[]
  tags         ClientTag[]
  payments     Payment[]
  reviewRequests ReviewRequest[]
  appointments Appointment[]

  @@index([organizationId])
  @@index([organizationId, deletedAt])
}

model Tag {
  id             String       @id @default(cuid())
  organizationId String
  label          String
  color          String       @default("#4F46E5")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clients      ClientTag[]

  @@unique([organizationId, label])
}

model ClientTag {
  clientId String
  tagId    String

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([clientId, tagId])
}

model Lead {
  id                 String      @id @default(cuid())
  organizationId     String
  name               String
  email              String?
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  projectType        String?
  description        String?
  photos             String?     @default("[]")
  source             String?
  status             String      @default("NEW")
  aiCategory         String?
  aiConfidence       Float?
  assignedToId       String?
  claimedById        String?
  claimedAt          DateTime?
  contactedAt        DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("LeadAssignee", fields: [assignedToId], references: [id])
  claimedBy    User?        @relation("LeadClaimer", fields: [claimedById], references: [id])
  activities   ActivityEvent[]
  phoneCalls   AiPhoneCall[]
  appointments Appointment[]

  @@index([organizationId, status])
  @@index([assignedToId])
}

model HomeownerRequest {
  id              String   @id @default(cuid())
  organizationId  String?
  name            String
  email           String
  phone           String?
  address         String?
  zip             String?
  projectType     String?
  description     String?
  photos          String?  @default("[]")
  createdAt       DateTime @default(now())
  convertedLeadId String?
  organization    Organization? @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Lead Center — platform-owned homeowner leads auto-routed to the best org.
// A PlatformLead is the routing state machine (HomeownerRequest stays the raw
// immutable submission log); the org-scoped Lead row is created only when an
// offer is accepted or an admin manually assigns. SQLite-safe string statuses
// live in src/lib/prismaEnums.ts (PlatformLeadStatus / LeadOfferStatus).
// ─────────────────────────────────────────────

model PlatformLead {
  id                 String    @id @default(cuid())
  homeownerRequestId String?   @unique
  name               String
  email              String
  phone              String?
  address            String?
  city               String?
  state              String?
  zip                String?
  lat                Float?
  lng                Float?
  projectType        String?
  description        String?
  photos             String?   @default("[]")
  detectedTrade      String? // canonical TRADE_TYPES value (src/lib/tradeTypes.ts)
  aiConfidence       Float?
  status             String    @default("MATCHING") // MATCHING | OFFERED | MATCHED | MANUAL_QUEUE
  attemptCount       Int       @default(0)
  rankingJson        String? // snapshot: ordered [{orgId,orgName,score,distanceMi,distanceScore,ratingScore,respScore,fallback}]
  queueReason        String? // NO_CANDIDATES | EXHAUSTED
  matchedOrgId       String?
  matchedLeadId      String?
  matchedAt          DateTime?
  assignedByAdminId  String? // set when a platform admin manually assigns
  priceCents         Int? // schema-ready for pay-to-unlock; unused in v1
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  offers LeadOffer[]

  @@index([status, createdAt])
}

model LeadOffer {
  id                 String    @id @default(cuid())
  platformLeadId     String
  organizationId     String
  attempt            Int // 1..3
  status             String    @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | EXPIRED | CANCELLED
  score              Float
  scoreBreakdownJson String? // {distanceMi,distanceScore,ratingScore,respScore,total,fallback}
  expiresAt          DateTime
  respondedAt        DateTime?
  respondedById      String?
  priceCents         Int? // schema-ready for pay-to-unlock; unused in v1
  unlockedAt         DateTime? // schema-ready masking gate; unused in v1
  createdAt          DateTime  @default(now())

  platformLead PlatformLead @relation(fields: [platformLeadId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([platformLeadId, organizationId]) // an org is never offered the same lead twice
  @@index([organizationId, status])
  @@index([status, expiresAt]) // cron expiry sweep
}

// ─────────────────────────────────────────────
// Proposals + Money
// ─────────────────────────────────────────────

model Proposal {
  id              String         @id @default(cuid())
  publicId        String         @unique
  organizationId  String
  ownerId         String?
  clientId        String?
  title           String
  description     String?
  scopeOfWork     String?
  notes           String?
  status          String         @default("DRAFT")
  subtotal        Float          @default(0)
  discountTotal   Float          @default(0)
  taxRate         Float          @default(0)
  taxTotal        Float          @default(0)
  total           Float          @default(0)
  currency        String         @default("USD")

  // Estimating engine — markup ladder applied to base material/labor costs
  materialMarkupPct Float        @default(0)
  laborMarkupPct    Float        @default(0)
  overheadPct       Float        @default(0)
  profitPct         Float        @default(0)
  validUntil      DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  viewCount       Int            @default(0)
  acceptedAt      DateTime?
  acceptedIp      String?
  declinedAt      DateTime?
  paidAt          DateTime?
  pdfUrl          String?
  aiDraftId       String?
  beforePhotos    String?        @default("[]")
  afterPhotos     String?        @default("[]")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          User?          @relation("ProposalOwner", fields: [ownerId], references: [id])
  client         Client?        @relation(fields: [clientId], references: [id])
  lineItems      LineItem[]
  discounts      Discount[]
  installments   Installment[]
  invoices       Invoice[]
  payments       Payment[]
  activities     ActivityEvent[]
  jobs           Job[]
  changeOrders   ChangeOrder[]
  aiDraft        AiDraft?       @relation(fields: [aiDraftId], references: [id])
  snapshots      PricingSnapshot[]
  appointments   Appointment[]

  @@index([organizationId, status])
  @@index([publicId])
}

model PricingSnapshot {
  id             String   @id @default(cuid())
  proposalId     String
  organizationId String
  reason         String   @default("manual") // manual | sent | accepted | edited
  subtotal       Float
  discountTotal  Float    @default(0)
  taxRate        Float    @default(0)
  taxTotal       Float
  total          Float
  currency       String   @default("USD")
  lineItemsJson  String   // JSON-encoded snapshot of line items
  createdAt      DateTime @default(now())

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, createdAt])
}

model LineItem {
  id              String   @id @default(cuid())
  proposalId      String
  name            String
  description     String?
  measurementType String   @default("UNIT")
  quantity        Float    @default(1)
  unitPrice       Float    @default(0)
  materialCost    Float    @default(0)
  laborCost       Float    @default(0)
  total           Float    @default(0)
  position        Int      @default(0)

  // Live-pricing product metadata from the AI estimator's SerpAPI matches, so
  // the Materials Request view can render a shoppable line. Null for hand-typed
  // or labor lines.
  store           String?
  productUrl      String?
  imageUrl        String?
  dimensions      String?

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId])
}

model Discount {
  id         String @id @default(cuid())
  proposalId String
  label      String
  amount     Float  @default(0)
  isPercent  Boolean @default(false)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Installment {
  id         String   @id @default(cuid())
  proposalId String
  label      String
  amount     Float
  isPercent  Boolean  @default(false)
  dueDate    DateTime?
  position   Int      @default(0)

  proposal Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model ProposalTemplate {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  body           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  proposalId     String?
  clientId       String?
  number         String
  amount         Float
  status         String   @default("PENDING")
  provider       String   @default("MANUAL")
  externalId     String?
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id])
  payments     Payment[]

  @@index([organizationId, status])
}

model Payment {
  id             String   @id @default(cuid())
  organizationId String
  proposalId     String?
  invoiceId      String?
  clientId       String?
  amount         Float
  currency       String   @default("USD")
  provider       String   @default("STRIPE")
  status         String   @default("PENDING")
  externalId     String?
  method         String?
  paidAt         DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  proposal     Proposal?    @relation(fields: [proposalId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])
  client       Client?      @relation(fields: [clientId], references: [id])

  @@index([organizationId, status])
}

// ─────────────────────────────────────────────
// Scheduling + Jobs + Workers
// ─────────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String?
  proposalId     String?
  projectId      String?
  title          String
  status         String    @default("SCHEDULED")
  scopeOfWork    String?   // seeded from the linked proposal's scope; shown above notes on the job
  notes          String?
  startsAt       DateTime?
  endsAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?        @relation(fields: [clientId], references: [id])
  proposal     Proposal?      @relation(fields: [proposalId], references: [id])
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  events       JobEvent[]
  assignments  JobAssignment[]
  photos       JobPhoto[]
  expenses     JobExpense[]
  messages     JobMessage[]
  conversation Conversation?
  changeOrders   ChangeOrder[]
  reviewRequests ReviewRequest[]

  @@index([organizationId, status])
  @@index([projectId])
}

model JobEvent {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?
  // Who created it — lets a jobless event (installer's optional-job path) still
  // render on its creator's own calendar. Nullable: legacy events have none.
  createdById    String?
  title          String
  startsAt       DateTime
  endsAt         DateTime
  notes          String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?         @relation(fields: [jobId], references: [id])
  createdBy    User?        @relation("JobEventCreator", fields: [createdById], references: [id])

  @@index([organizationId, startsAt])
}

model WorkerProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  organizationId String
  displayName    String
  phone          String?
  specialties    String?  @default("[]")
  hourlyRate     Float?
  token          String   @unique @default(cuid())
  // Invite lifecycle: PENDING (sent, awaiting response) → ACCEPTED / DECLINED.
  // Defaults to ACCEPTED so legacy profiles (created before this feature) stay
  // active; createWorkerInvite sets PENDING explicitly for new/re-invites.
  // DECLINED is excluded from the "workers" plan-limit count (frees the seat).
  inviteStatus   String   @default("ACCEPTED")
  respondedAt    DateTime?
  createdAt      DateTime @default(now())
  // Rolling "last time this worker was genuinely active in their portal" (see
  // touchWorkerActivity). Nullable: existing rows stay null until the one-time
  // backfill runs. The inactivity cron NEVER revokes a null row — only a real
  // date older than 6 months — so null is always safe.
  lastSeenAt     DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  JobAssignment[]
  appointmentAssignments AppointmentAssignment[]

  @@index([organizationId])
  @@index([lastSeenAt])
}

model JobAssignment {
  id         String   @id @default(cuid())
  jobId      String
  workerId   String
  status     String   @default("PENDING")
  assignedAt DateTime @default(now())
  pingedAt   DateTime?

  job    Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  worker WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([jobId, workerId])
}

model JobPhoto {
  id        String   @id @default(cuid())
  jobId     String
  url       String
  kind      String   @default("BEFORE")
  caption   String?
  analysis  String?   // JSON-encoded vision output
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobExpense {
  id         String   @id @default(cuid())
  jobId      String
  category   String
  amount     Float
  note       String?
  receiptUrl String?
  ocrJson    String?   // JSON-encoded OCR output
  createdAt  DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobMessage {
  id        String   @id @default(cuid())
  jobId     String
  authorId  String?
  body      String
  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────
// Comms
// ─────────────────────────────────────────────

model Conversation {
  id             String   @id @default(cuid())
  organizationId String
  jobId          String?  @unique
  // DIRECT (1:1) | GROUP (manager-created, multi-person) | JOB (auto-created from a job's crew)
  kind           String   @default("DIRECT")
  title          String?
  createdAt      DateTime @default(now())

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  messages     Message[]
  participants ConversationParticipant[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

// Per-user "last looked at this nav surface" timestamps. Drives view-based
// clearing of the sidebar/tab-bar badges: a badge counts only items newer than
// the user's seenAt for that surface, so visiting the page clears it until
// something new arrives. `key` is a short surface id ("leads" | "proposals" |
// "hire" | "referrals" | "reviews"). Scalar userId/organizationId (no
// relations) keeps the blast radius to this one model; orphaned rows after a
// delete are harmless. The unique index doubles as the lookup index.
model NavSeen {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  key            String
  seenAt         DateTime @default(now())

  @@unique([userId, organizationId, key])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  authorId       String?
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation(fields: [authorId], references: [id])
}

model Announcement {
