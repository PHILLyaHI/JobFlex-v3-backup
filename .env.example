# ────────────────────────────────────────────────
# JobFlex environment variables
# Copy to .env.local and fill in the keys you want
# to activate. Any missing key gracefully disables
# its feature at runtime (no crashes).
# ────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL=""                         # Neon direct (migrations)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""                    # openssl rand -base64 32

# ── OAuth ────────────────────────────────────────
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── OpenAI ───────────────────────────────────────
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
# Video estimator's reader (actions/videoEstimator.ts). Reads stills off a
# walkthrough against reference objects for scale — spatial reasoning the mini
# tier gets wrong — so it has its own knob. Transcription is whisper-1.
OPENAI_VIDEO_MODEL="gpt-4o"

# ── Scraper ──────────────────────────────────────
# SerpAPI (Google Shopping) — live retail pricing for the advanced material
# estimator. Missing key falls back to deterministic mock products (dev never
# crashes). Get a key at https://serpapi.com.
SERPAPI_API_KEY=""

# ── Stripe ───────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Sandbox pair. The /admin/integrations "Payments mode" switch flips checkout
# between the live account (STRIPE_SECRET_KEY) and this one at runtime.
STRIPE_SECRET_KEY_TEST=""
STRIPE_PUBLISHABLE_KEY_TEST=""
# Stripe Connect (contractors get paid through JobFlex). Dashboard → Connect →
# Onboarding options → OAuth for Standard accounts ON; register the redirect
# URI <app>/api/integrations/stripe/callback. Each client id is mode-specific.
STRIPE_CONNECT_CLIENT_ID=""
STRIPE_CONNECT_CLIENT_ID_TEST=""
# Second webhook endpoint, <app>/api/webhooks/stripe-connect, created with
# "Listen to events on Connected accounts". Its own signing secret per mode.
STRIPE_CONNECT_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET_TEST=""

# ── Platform payments ────────────────────────────
# JobFlex's cut of every payment collected through a contractor's Stripe or
# Square, in basis points (100 = 1%). Applied server-side at checkout.
PLATFORM_FEE_BPS="100"
# Square requires the platform and the seller to be in the same country for
# app fees; a seller elsewhere is refused at connect time.
PLATFORM_COUNTRY="US"
# AES-256-GCM key for OAuth tokens at rest (Square). `openssl rand -base64 32`.
TOKEN_ENCRYPTION_KEY=""

# ── PostHog (admin traffic) ──────────────────────
# TWO halves. The public key below is the SEND half: posthog-js in the root
# layout fires a $pageview on every route change (/admin is excluded — those
# pages are the dashboard, not traffic). Without it the project stays empty
# and the admin honestly reads zero.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""   # optional, defaults to https://us.i.posthog.com
#
# The three below are the READ half.
# Server-side only. Unlocks /admin/traffic (daily visitors + pageviews, top
# pages, 24h/7d/30d visitor tiles) and the PostHog tile on /admin. Without
# these the admin shows "Not connected" — visitor counts are never estimated.
# Personal API key needs query:read; project id is the numeric one from the
# project settings URL. Host defaults to https://us.posthog.com.
POSTHOG_PERSONAL_API_KEY=""
POSTHOG_PROJECT_ID=""
POSTHOG_HOST=""

# ── Square (OAuth platform app) ──────────────────
# Developer Console → your app → OAuth: redirect URL
# <app>/api/integrations/square/callback. Sandbox and production are separate
# apps with separate ids/secrets/keys.
SQUARE_APPLICATION_ID=""
SQUARE_APPLICATION_SECRET=""
SQUARE_ENV="sandbox"                  # sandbox | production
# Webhooks → subscription URL <app>/api/webhooks/square, events
# payment.updated, refund.updated, oauth.authorization.revoked.
SQUARE_WEBHOOK_SIGNATURE_KEY=""
# Only when the public URL differs from what the app sees (proxies). Must
# byte-match the URL registered on the subscription.
SQUARE_WEBHOOK_URL=""

# ── Email ────────────────────────────────────────
# Two transports. Resend is the production path (key on Vercel). SMTP is the
# local/dev fallback — e.g. a Gmail app password. If neither is set, email is a
# no-op stub (logged, never sent). Precedence: Resend → SMTP.
RESEND_API_KEY=""
EMAIL_FROM="JobFlex <app@jobflex.app>"

# SMTP fallback (e.g. Gmail). SMTP_SECURE=false for port 587 (STARTTLS);
# set true only for port 465 (implicit TLS). FROM_EMAIL must match SMTP_USER
# for Gmail (it rewrites mismatched From headers).
# Deliverability: send from a Google Workspace mailbox whose domain has SPF
# (v=spf1 include:_spf.google.com ~all) + DKIM, or recipients may flag it as
# spam. Gmail caps ~500/day (Workspace ~2000); use Resend for production volume.
# Customer-facing emails build links from NEXT_PUBLIC_APP_URL — set it in prod
# or links will point at localhost.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
FROM_EMAIL=""

# Where new support-ticket alerts are emailed — every ticket raised from the
# corner Help widget or /dashboard/support. Comma-separated. If unset, alerts go
# to every user flagged isPlatformAdmin; if that set is empty too, nothing is
# sent. The send is best-effort and never blocks or fails a submission — but it
# is no longer silent: every skip and every transport error is logged with the
# ticket reference (see notifySupportTicket in src/lib/notify.ts), and the
# tickets themselves are always in /admin/support regardless of mail state.
# Needs a transport configured above (RESEND_API_KEY, or the SMTP_* block).
SUPPORT_NOTIFY_EMAIL=""

# ── SMS ──────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── Gmail OAuth (per-user) ───────────────────────
GMAIL_OAUTH_CLIENT_ID=""
GMAIL_OAUTH_CLIENT_SECRET=""
GMAIL_OAUTH_REDIRECT_URI="http://localhost:3000/api/integrations/gmail/callback"
# Google keeps an OAuth app in "Testing" until it passes verification, and only
# listed test users may consent. Leave this unset while that is true: Settings
# then marks Gmail "Coming soon" for everyone. Set to "true" after Google
# verifies the app.
GMAIL_OAUTH_PUBLIC=""

# ── FAL.ai (roof segmentation) ───────────────────
FAL_KEY=""

# ── Regrid (parcel boundaries · fence estimator) ──
# Exact surveyed property polygons for /dashboard/advanced-ai/fence/studio
# ("Load Property Lines"). Get a key at regrid.com/api. Missing key → the studio
# shows a hint and you draw the fence manually.
REGRID_API_KEY=""

# ── ReportAll USA (parcel boundaries) ─────────────────
# Cadastral parcel polygons + owner/acreage for the fence estimator's map trace
# (reportallusa.com). ALLTIME quota (not monthly) — every result is cached in
# ParcelCache and misses in ParcelMiss, so repeat lookups cost nothing.
REPORTALL_CLIENT_KEY=

# ── EagleView (roof measurement) ─────────────────
# Contract-grade roof geometry for /dashboard/advanced-ai/roof (per-facet pitch,
# area, edges → 2D wireframe + 3D model). Client-credentials OAuth. NOTE: the
# token is minted on the PRODUCTION host while API calls go to the SANDBOX host —
# both overridable below. Missing keys disable the feature (page shows a hint).
# Reports are billable once ordered live; the UI works against free canned
# sandbox reports without placing any order.
EAGLEVIEW_CLIENT_ID=""
EAGLEVIEW_CLIENT_SECRET=""
EAGLEVIEW_TOKEN_BASE_URL="https://apicenter.eagleview.com"       # OAuth token host (prod)
EAGLEVIEW_API_BASE_URL="https://sandbox.apicenter.eagleview.com" # API host (sandbox)
# Which roof estimator the page shows. Unset / "false" → the DATA view:
# EagleView Instant numbers + ortho photo, no reconstruction, no server
# geocode. "true" → the DRAWING tool: free Google Solar reconstruction, which
# needs GOOGLE_MAPS_API_KEY to be entitled to Geocoding + Solar. Opt-in, so a
# deploy that never sets it shows the same page as local dev.
ROOF_DRAWING_ENABLED=false

# ── Google Maps (Places autocomplete + geocode) ──
# Server key: must be entitled to Geocoding, Solar (roof drawing tool),
# Elevation (fence topography) and Maps Static, with NO HTTP-referrer
# restriction — the Geocoding web service rejects referrer-restricted keys as
# REQUEST_DENIED, which the roof page reports verbatim. Also pins orgs and
# homeowner leads for Lead Center distance matching (unset → zip-based fallback).
# Paste the bare key: quotes or whitespace around the value become part of it.
# Browser key powers Places Autocomplete on the roof address field — it ships to
# the client, so restrict it to HTTP referrers + the Places API in Google Cloud
# Console.
GOOGLE_MAPS_API_KEY=""
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# ── Vercel Blob ──────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ── Public app ───────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="JobFlex"

# ── Admin console / cron ─────────────────────────
# Shared secret for the scheduled jobs in src/app/api/cron/* (commission
# clearing, Stripe reconciliation, payout processing). Vercel Cron also sends
# this as `Authorization: Bearer <CRON_SECRET>`. Leave blank in dev to allow
# unauthenticated cron calls.
CRON_SECRET=""
# Influencer payouts use Stripe Connect (Express) via the platform STRIPE_SECRET_KEY
# above — no extra Connect key is required for transfers. Onboarding + payouts
# only run in live/real Stripe mode.

# Platform admin panel login (/admin/login). Use a long random password —
# attempts are rate-limited (10 per 15 min per IP and per username) but the
# secret's length is the real defence.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Safety switches ──────────────────────────────
# Plan sync / coupons / Connect transfers WRITE to Stripe. On a live key those
# writes are refused unless this is exactly "true". Leave unset locally.
STRIPE_ALLOW_LIVE_WRITES=
# Register-page "Skip for now" (create the workspace with no subscription).
# Testing convenience only: the server honours it ONLY when NODE_ENV is not
# production AND this is "true". Never set in production.
SIGNUP_ALLOW_SKIP=
