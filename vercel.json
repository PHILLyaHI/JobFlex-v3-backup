{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "prisma generate && prisma db push --skip-generate --accept-data-loss && next build",
  "crons": [
    { "path": "/api/cron/follow-ups", "schedule": "0 * * * *" },
    { "path": "/api/cron/clear-commissions", "schedule": "0 6 * * *" },
    { "path": "/api/cron/reconcile-stripe", "schedule": "0 */6 * * *" },
    { "path": "/api/cron/process-approved-payouts", "schedule": "30 6 * * *" }
  ]
}
